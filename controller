#!/bin/bash

# Ambient-light brightness controller for one display: an Apple Studio
# Display when one is connected, else the laptop panel while its lid is open.
# Owns that display in both modes. Prints one JSON status line per poll on
# stdout; Service.qml reads them and sends settings and requests on stdin:
#   auto on|off   follow the room, or leave brightness where it is
#   offset N      correction to the curve, in brightness points
#   manual N      the user picked N: write it, and with auto on make it the
#                 new offset
# Each status carries `seen`, the commands handled so far, so the service can
# tell a status sent before its last command from one that reflects it.
#
# Usage: controller [--self-test]
#
# Procedure, per 0.5 s poll (the shape Android documents and macOS shows):
#   lux -> smoothing -> asymmetric hysteresis + debounce -> curve -> ramp
# A manual change does not stop auto. It becomes the offset: the distance
# from the curve at that moment, kept at every light level until the user
# clears it. The service persists it, and sends it back on start.

set -u
export LC_ALL=C  # printf %.1f must emit a dot, whatever the session locale

# Lux = (raw + als_offset) * als_scale, set per sensor on discovery.
apple_als_scale=0.001  # the Studio Display reports millilux, though its kernel scale reads 1.0
als_scale=1
als_offset=0
iio_root=/sys/bus/iio/devices
poll_interval=0.5
retry_interval=5  # while no display or sensor is present
# Idle read-back interval. Every read-back is a `sudo asdcontrol` call that
# lands in the journal. Before any write there is always a read-back, so a
# hotkey press is never overwritten; while idle this is how often one is
# noticed. It is also how often the active display is re-chosen, so
# plugging the Studio Display in or out switches over within it.
manual_check_interval=10
lux_ema_alpha=0.25
brighten_threshold=0.10  # accept a brighter room at 10% above the accepted lux
darken_threshold=0.20    # and a darker one at 20% below
brighten_debounce=4      # seconds the new level must hold before it is accepted
darken_debounce=8
# Ramp: a fixed rate in points per second, but any change completes within
# the cap, the shape Android uses for automatic changes. This display shows
# about 20 visible steps, so a faster fade reads smoother, not harsher.
brighten_rate=20
brighten_cap=2
dim_rate=13
dim_cap=3
# Transitions are as smooth as the hardware allows. Each poll's move is
# spread over the poll as evenly paced writes, one per write's time (about
# 80 ms on the Studio Display, 4 ms on a laptop backlight) but no faster than
# max_frame_rate, which is past what the eye resolves as steps. On a display
# with fine levels the fade is interpolated in log luminance, as perceived
# brightness goes; on a coarse one, linearly, since a log fade would only
# bunch its few visible steps together.
# First estimate, measured from the first write on. Optimistic: a slower
# display only runs into the fade's deadline for the first poll.
write_seconds=0.02
max_frame_rate=60
levels=100         # brightness units end to end; set by the display's profile

# Lux anchors -> brightness percent, interpolated in log2(lux). One percent is
# about 6 nits on this display (raw 400..60000 spans roughly 4..600 nits), so
# this sits between the sRGB reference (80 nits at 64 lux) and the display's
# own idea of "dim": 5% ~ 30 nits in the dark, 24% ~ 145 nits at 100 lux.
lux_points="0 5 20 50 100 200 400 800 1500 3000 5000"
pct_points="5 9 14 19 24 30 38 48 60 80 100"

# Settings, as last sent by the service. Paused until told otherwise.
paused=1
offset=0

# One awk pass over the whole pipeline. Inputs and outputs are the loop state,
# so bash never does floating point.
#   in:  raw filtered accepted pending_dir pending_since now brightness ramp_target ramp_span
#   out: filtered accepted pending_dir pending_since brightness curve target desired ramp_target ramp_span
#   (desired is in the display's units, the rest in percent)
calculate() {
  awk \
    -v raw="$1" -v filtered="$2" -v accepted="$3" \
    -v pending_dir="$4" -v pending_since="$5" -v now="$6" \
    -v brightness="$7" -v ramp_target="${8:-}" -v ramp_span="${9:-0}" \
    -v scale="$als_scale" -v als_offset="$als_offset" -v offset="$offset" -v paused="$paused" \
    -v lux_alpha="$lux_ema_alpha" \
    -v up_threshold="$brighten_threshold" -v down_threshold="$darken_threshold" \
    -v up_debounce="$brighten_debounce" -v down_debounce="$darken_debounce" \
    -v up_rate="$brighten_rate" -v up_cap="$brighten_cap" \
    -v down_rate="$dim_rate" -v down_cap="$dim_cap" -v poll="$poll_interval" \
    -v lux_points="$lux_points" -v pct_points="$pct_points" -v levels="$levels" '
    function curve(value,    n, i, x, xa, xb, t) {
      n = split(lux_points, lp, " ")
      split(pct_points, pp, " ")
      if (value <= lp[1]) return pp[1]
      if (value >= lp[n]) return pp[n]
      x = log(value + 1) / log(2)
      for (i = 2; i <= n; i++) {
        if (value <= lp[i]) {
          xa = log(lp[i - 1] + 1) / log(2)
          xb = log(lp[i] + 1) / log(2)
          t = (x - xa) / (xb - xa)
          return pp[i - 1] + t * (pp[i] - pp[i - 1])
        }
      }
      return pp[n]
    }
    function clamp(v) { return v < 1 ? 1 : (v > 100 ? 100 : v) }
    BEGIN {
      lux = (raw + als_offset) * scale
      filtered = filtered == "" ? lux : filtered + lux_alpha * (lux - filtered)

      if (accepted == "") {
        accepted = filtered
        pending_dir = 0
        pending_since = now
      } else {
        base = accepted > 1 ? accepted : 1
        dir = 0
        if (filtered > accepted + base * up_threshold) dir = 1
        else if (filtered < accepted - base * down_threshold) dir = -1
        if (dir != pending_dir) { pending_dir = dir; pending_since = now }
        if (dir != 0 && now - pending_since >= (dir > 0 ? up_debounce : down_debounce)) {
          accepted = filtered
          pending_dir = 0
          pending_since = now
        }
      }

      base_target = curve(accepted)
      target = clamp(base_target + offset)

      # Paused: the display stays where it is; the curve is still reported.
      if (brightness == "") brightness = target
      else if (!paused) {
        delta = target - brightness
        span = delta < 0 ? -delta : delta
        # The cap is measured from where the ramp started, so a large change
        # really does finish within it instead of decaying towards it.
        if (ramp_target == "" || target != ramp_target + 0) { ramp_target = target; ramp_span = span }
        rate = delta > 0 ? up_rate : down_rate
        cap = delta > 0 ? up_cap : down_cap
        step = rate * poll
        if (ramp_span * poll / cap > step) step = ramp_span * poll / cap
        brightness = span <= step ? target : brightness + (delta > 0 ? step : -step)
      }
      desired = int(clamp(brightness) * levels / 100 + 0.5)

      printf "%.10f %.10f %d %d %.10f %.10f %.10f %d %.10f %.10f\n", \
        filtered, accepted, pending_dir, pending_since, brightness, base_target, target, desired, ramp_target, ramp_span
    }'
}

# The user chose a brightness: the ramp restarts from it, and with auto on it
# becomes the offset from the curve as it stands now. The caller decides
# whether the display is already there.
learn_manual() {
  local value="$1"
  [[ $value =~ ^[0-9]+$ ]] || return
  (( paused )) || offset=$(awk -v v="$value" -v b="${base_target:-$value}" 'BEGIN { printf "%d", v - b + (v - b < 0 ? -0.5 : 0.5) }')
  brightness=$value
  ramp_target=""
}

# Seconds per write while fading: the write's own time, but at most
# max_frame_rate writes a second.
frame_seconds() {
  awk -v w="$write_seconds" -v r="$max_frame_rate" 'BEGIN { f = 1 / r; printf "%.4f", (w > f ? w : f) }'
}

# The writes that take the display from units FROM to TO over SECONDS, one
# per frame: interpolated in log luminance when levels are fine, linearly
# when coarse, rounded to whole units, repeats dropped. Always ends on TO.
ramp_frames() {
  awk -v from="$1" -v to="$2" -v seconds="$3" -v frame="$(frame_seconds)" -v levels="$levels" 'BEGIN {
    n = int(seconds / frame); if (n < 1) n = 1
    a = from < 1 ? 1 : from; b = to < 1 ? 1 : to
    prev = from
    for (i = 1; i <= n; i++) {
      t = i / n
      v = levels > 100 ? exp(log(a) + (log(b) - log(a)) * t) : a + (b - a) * t
      v = i == n ? to : int(v + 0.5)
      if (v != prev) print v
      prev = v
    }
  }'
}

# Percent of the display's range, for status and learning, from units.
units_pct() {
  awk -v u="$1" -v l="$levels" 'BEGIN { printf "%d", u * 100 / l + 0.5 }'
}

# Display profiles, in priority order: the first kind with a matching output
# is driven. Supporting another display means adding a kind here. Each
# defines:
#   <kind>_match NAME     the Hyprland output NAME is this kind
#   <kind>_attach         prepare writes to $monitor; fail if impossible
#   <kind>_sensor DEV     DEV, an IIO device, is this display's light sensor;
#                         print "file scale offset"
#   <kind>_levels         print the brightness units end to end
#   <kind>_read           print the brightness, in units
#   <kind>_write UNITS    set the brightness, in units
profiles="apple panel"

# Apple: the same test omarchy-brightness-display routes on, so the output
# chosen is the one writes reach. The sensor is the HID sensor hub under the
# display's USB device (vendor 05ac). Writes go to the Apple script directly;
# see write_display.
apple_match() { is_apple "$1"; }
is_apple() { omarchy-hyprland-monitor-focused-apple "$1" 2>/dev/null; }
apple_attach() { :; }
apple_sensor() {
  [[ $(<"$1/name") == als && -r $1/in_illuminance_raw && $(readlink -f "$1") == *05[aA][cC]:* ]] || return 1
  printf '%s %s 0\n' "$1/in_illuminance_raw" "$apple_als_scale"
}
apple_levels() { echo 100; }  # percent: asdcontrol's 400..60000 shows only about 20 steps
apple_read() { timeout 10 omarchy-brightness-display --monitor "$monitor" 2>/dev/null; }
apple_write() { timeout 10 omarchy-brightness-display-apple --no-osd "$1%" >/dev/null 2>&1; }

# Panel: the laptop's internal output. A closed lid disables it, which drops
# it from the outputs considered. The sensor is any IIO illuminance device
# that is not the Studio Display's, with the kernel's own scale and offset,
# or its processed reading when that is all it exposes.
panel_match() { [[ $1 =~ ^(eDP|LVDS|DSI)- ]]; }
panel_attach() { backlight=$(omarchy-hw-display); }
panel_sensor() {
  local scale=1 offset=0
  [[ $(readlink -f "$1") == *05[aA][cC]:* ]] && return 1
  if [[ -r $1/in_illuminance_raw ]]; then
    [[ -r $1/in_illuminance_scale ]] && scale=$(<"$1/in_illuminance_scale")
    [[ -r $1/in_illuminance_offset ]] && offset=$(<"$1/in_illuminance_offset")
    printf '%s %s %s\n' "$1/in_illuminance_raw" "${scale:-1}" "${offset:-0}"
  elif [[ -r $1/in_illuminance_input ]]; then
    printf '%s 1 0\n' "$1/in_illuminance_input"
  else
    return 1
  fi
}
panel_levels() { cat "/sys/class/backlight/$backlight/max_brightness"; }
panel_read() { cat "/sys/class/backlight/$backlight/brightness"; }
panel_write() { timeout 10 brightnessctl -q -d "$backlight" set "$1" >/dev/null 2>&1; }

# Which output to drive, from `hyprctl monitors -j` on stdin. Prints
# "name kind".
pick_monitor() {
  local outputs kind name
  mapfile -t outputs < <(jq -r '.[] | select(.disabled != true) | .name' 2>/dev/null)
  for kind in $profiles; do
    for name in "${outputs[@]}"; do
      [[ -n $name ]] && "${kind}_match" "$name" && { printf '%s %s\n' "$name" "$kind"; return 0; }
    done
  done
  return 1
}

detect_monitor() {
  timeout 5 hyprctl monitors -j 2>/dev/null | pick_monitor
}

# The light sensor for a display kind. Prints "file scale offset".
discover_sensor() {
  local dev
  for dev in "$iio_root"/iio:device*; do
    [[ -r $dev/name ]] && "${1}_sensor" "$dev" && return 0
  done
  return 1
}

handle_command() {
  commands_seen=$(( commands_seen + 1 ))
  case "$1" in
    auto)
      local next=1
      [[ $2 == on ]] && next=0
      (( next == paused )) && return
      paused=$next
      # Start from wherever the display is now; a value set while Auto was
      # off is not a correction to the curve.
      brightness=""
      last_applied=0
      ;;
    offset) [[ $2 =~ ^-?[0-9]+$ ]] && (( $2 != offset )) && { offset=$2; ramp_target=""; } ;;
    manual) learn_manual "$2" && user_request=1 ;;  # written at once, next pass
  esac
}


# Read the display. Returns 0 when it is where we left it, 1 when someone
# else moved it (now adopted), 2 when it could not be read.
sync_from_display() {
  local current
  current=$("${kind}_read" || true)
  [[ $current =~ ^[0-9]+$ ]] || return 2
  last_read=$SECONDS
  read_this_poll=1
  if (( last_applied == 0 || current == last_applied )); then
    last_applied=$current
    [[ -n $brightness ]] || brightness=$(units_pct "$current")
    return 0
  fi
  learn_manual "$(units_pct "$current")"
  last_applied=$current
  return 1
}

# Writes bypass the routing helper, straight to the profile's own path. The
# helper holds a non-blocking lock and silently drops a write
# that collides with a hotkey, in either direction: a ramp would lose its own
# steps, or drop the user's presses. Without the lock both writes reach the
# display, and the read-back before the next write adopts whichever landed
# last.
write_display() {
  local started=$EPOCHREALTIME
  "${kind}_write" "$1" || return 1
  last_applied=$1
  write_seconds=$(awk -v a="$started" -v b="$EPOCHREALTIME" -v w="$write_seconds" 'BEGIN { printf "%.4f", w + 0.3 * ((b - a) - w) }')
}

# Fade from where the display is to the target over one poll, a write per
# frame. The wait between frames is the command reader too, so a command cuts
# the fade short and is handled at once; EOF means the service is gone. Writes
# slower than planned stop at the poll's end, and the next poll fades on from
# wherever the display got to.
write_ramp() {
  local to="$1" frame value left n=0 fade_started=$EPOCHREALTIME
  if (( last_applied == 0 )); then write_display "$to"; return; fi
  frame=$(frame_seconds)
  while read -r value; do
    write_display "$value" || return 1
    n=$(( n + 1 ))
    # Frames keep to a clock from the fade's start, so overhead never adds up.
    left=$(awk -v f="$frame" -v n="$n" -v b="$EPOCHREALTIME" -v s="$fade_started" -v p="$poll_interval" \
      'BEGIN { if (b - s >= p) { print "over"; exit } l = s + n * f - b; printf "%.4f", (l > 0 ? l : 0) }')
    [[ $left == over ]] && return 0
    [[ $left == 0.0000 ]] && continue
    if read -t "$left" -r command argument <&3; then
      handle_command "$command" "${argument:-}"
      return 0
    elif (( $? <= 128 )); then
      exit 0
    fi
  done < <(ramp_frames "$last_applied" "$to" "$poll_interval")
}

emit_status() {
  local available="$1" error="$2" p=false
  (( paused )) && p=true
  printf '{"available":%s,"monitor":"%s","lux":%.1f,"brightness":%d,"target":%.1f,"offset":%d,"paused":%s,"seen":%d,"error":"%s"}\n' \
    "$available" "$monitor" "${filtered_lux:-0}" "$(units_pct "$last_applied")" "${target:-0}" "$offset" "$p" "$commands_seen" "$error"
}

reset_state() {
  monitor=""
  kind=""
  backlight=""
  sensor=""
  last_detect=0
  filtered_lux=""
  accepted_lux=""
  pending_dir=0
  pending_since=0
  brightness=""
  base_target=""
  ramp_target=""
  ramp_span=0
  last_applied=0
  last_read=0
}


# The display could not be read. Drop it, so the next poll detects and
# attaches it afresh: its device may be back under another name.
display_lost() {
  emit_status true "Could not read the display"
  reset_state
  next_delay=$retry_interval
}

# One pass. Sets next_delay for the wait that follows.
poll() {
  next_delay=$poll_interval
  read_this_poll=0

  local chosen
  if [[ -z $monitor ]] || (( SECONDS - last_detect >= manual_check_interval )); then
    chosen=$(detect_monitor)
    if [[ $chosen != "$monitor $kind" ]]; then
      reset_state
      if [[ -z $chosen ]]; then
        emit_status false "No supported display connected"
        next_delay=$retry_interval
        return
      fi
      read -r monitor kind <<<"$chosen"
      if ! "${kind}_attach" || ! levels=$("${kind}_levels") || [[ ! $levels =~ ^[1-9][0-9]*$ ]]; then
        emit_status false "Cannot drive $monitor"
        reset_state
        next_delay=$retry_interval
        return
      fi
    fi
    last_detect=$SECONDS
  fi
  if [[ -z $sensor ]]; then
    if ! read -r sensor als_scale als_offset < <(discover_sensor "$kind"); then
      emit_status false "No light sensor found for $monitor"
      reset_state
      next_delay=$retry_interval
      return
    fi
  fi
  if ! raw=$(<"$sensor") || [[ ! $raw =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    emit_status false "Could not read the ambient light sensor"
    reset_state
    next_delay=$retry_interval
    return
  fi

  # First pass, and every idle interval: see where the display really is.
  if [[ -z $brightness ]] || (( SECONDS - last_read >= manual_check_interval )); then
    sync_from_display
    if (( $? == 2 )); then display_lost; return; fi
  fi

  read -r filtered_lux accepted_lux pending_dir pending_since brightness base_target target desired ramp_target ramp_span <<<"$(
    calculate "$raw" "$filtered_lux" "$accepted_lux" "$pending_dir" "$pending_since" "$SECONDS" "$brightness" "$ramp_target" "$ramp_span"
  )"

  if (( desired != last_applied )); then
    if (( user_request )); then
      # The user's hand lands at once; only the room is ramped.
      user_request=0
      write_display "$desired" || { emit_status true "Brightness command failed"; reset_state; return; }
    else
      # Never overwrite a hotkey press: look first, unless we looked this poll.
      if (( ! read_this_poll )); then
        sync_from_display
        case $? in
          1) emit_status true ""; return ;;
          2) display_lost; return ;;
        esac
      fi
      write_ramp "$desired" || { emit_status true "Brightness command failed"; reset_state; return; }
      # The fade took the poll already; carry straight on.
      next_delay=0.001
    fi
  fi

  emit_status true ""
}

if [[ ${1:-} == --self-test ]]; then
  fail() { echo "self-test: $*" >&2; exit 1; }
  run() {
    read -r filtered accepted dir since brightness base target desired ramp_target ramp_span <<<"$(calculate "$@")"
  }
  als_scale=1
  paused=0
  # The curve, and the offset on top of it.
  offset=6; run 20 "" "" 0 0 0 ""
  [[ $base == 14.0000000000 && $target == 20.0000000000 ]] || fail "curve(20)+6 gave $base $target"
  offset=-10; run 0 "" "" 0 0 0 ""
  (( desired == 1 )) || fail "curve(0)-10 should clamp to 1, got $desired"
  offset=10; run 5000 "" "" 0 0 0 ""
  (( desired == 100 )) || fail "curve(5000)+10 should clamp to 100, got $desired"
  offset=0
  # A brighter room is accepted only after 4 s above the band; darker after 8 s.
  run 100 10 10 0 0 0 20
  [[ $accepted == 10.0000000000 && $dir == 1 ]] || fail "brighten accepted too early: $accepted dir=$dir"
  run 100 90 10 1 0 3 20
  [[ $accepted == 10.0000000000 ]] || fail "brighten accepted at 3 s, want 4: $accepted"
  run 100 90 10 1 0 4 20
  [[ $accepted != 10.0000000000 && $dir == 0 ]] || fail "brighten not accepted at 4 s: $accepted"
  run 1 1 100 -1 0 7 40
  [[ $accepted == 100.0000000000 ]] || fail "darken accepted at 7 s, want 8: $accepted"
  run 1 1 100 -1 0 8 40
  [[ $accepted == 1.0000000000 ]] || fail "darken not accepted at 8 s: $accepted"
  run 105 105 100 0 0 30 40
  [[ $accepted == 100.0000000000 && $dir == 0 ]] || fail "5% wobble was not ignored: $accepted dir=$dir"
  # Ramp steps: 20 per poll up (cap-bound), 6.5 down, small changes at once.
  run 5000 5000 5000 0 0 0 20
  (( desired == 40 )) || fail "brighten step should be 20 points, got $((desired - 20))"
  run 0 0 0 0 0 0 40
  (( desired == 34 )) || fail "dim step should be 6.5 points, got $((40 - desired))"
  run 0 0 0 0 0 0 9
  (( desired == 5 )) || fail "small change should land at once, got $desired"
  # And a big change finishes within the cap: 20 -> 100 in 4 polls, 100 -> 5 in 6.
  brightness=20; ramp_target=""; ramp_span=0
  for _ in 1 2 3 4; do run 5000 5000 5000 0 0 0 "$brightness" "$ramp_target" "$ramp_span"; done
  (( desired == 100 )) || fail "brighten did not finish within the 2 s cap: $desired"
  brightness=100; ramp_target=""; ramp_span=0
  for _ in 1 2 3 4 5 6; do run 0 0 0 0 0 0 "$brightness" "$ramp_target" "$ramp_span"; done
  (( desired == 5 )) || fail "dim did not finish within the 3 s cap: $desired"
  # Paused: the display does not move.
  paused=1; run 5000 5000 5000 0 0 0 20
  (( desired == 20 )) || fail "paused ramp moved the display to $desired"
  paused=0
  # A manual 30% at a 14% curve point becomes a +16 offset; paused, it does not.
  base_target=14; learn_manual 30
  (( offset == 16 && brightness == 30 )) || fail "manual 30 over curve 14 gave offset $offset"
  paused=1; offset=0; learn_manual 40
  (( offset == 0 && brightness == 40 )) || fail "manual while paused changed the offset to $offset"
  # Frames follow the write latency, capped at 60 a second: an 80 ms display
  # writes every 80 ms, a 4 ms backlight every 1/60 s.
  write_seconds=0.08; [[ $(frame_seconds) == 0.0800 ]] || fail "80 ms frames: $(frame_seconds)"
  write_seconds=0.004; [[ $(frame_seconds) == 0.0167 ]] || fail "frames should cap at 60/s: $(frame_seconds)"
  # Coarse levels fade linearly: 20 -> 40 % in 0.5 s of 80 ms frames is six
  # writes, about 3 points apart, ending on 40.
  levels=100; write_seconds=0.08
  [[ $(ramp_frames 20 40 0.5 | paste -sd' ') == "23 27 30 33 37 40" ]] || fail "linear frames: $(ramp_frames 20 40 0.5 | paste -sd' ')"
  # Fine levels fade in log luminance: 1000 -> 100000 in 2 frames passes the
  # geometric middle, 10000, not the linear one.
  levels=192000; write_seconds=0.25
  [[ $(ramp_frames 1000 100000 0.5 | paste -sd' ') == "10000 100000" ]] || fail "log frames: $(ramp_frames 1000 100000 0.5 | paste -sd' ')"
  # A fine fade at 60/s is about 30 writes a poll, none repeated.
  write_seconds=0.004
  n=$(ramp_frames 9600 76800 0.5 | wc -l); (( n >= 29 && n <= 30 )) || fail "fine fade wrote $n frames, want about 30"
  [[ $(ramp_frames 9600 76800 0.5 | sort -u | wc -l) == "$n" ]] || fail "fine fade repeated a value"
  # Too short a fade for coarse levels: 5 -> 6 is one write, not ten.
  levels=100; write_seconds=0.004
  [[ $(ramp_frames 5 6 0.5 | paste -sd' ') == "6" ]] || fail "5 -> 6 should be one write: $(ramp_frames 5 6 0.5 | paste -sd' ')"
  # Units to percent for the status and learning.
  levels=192000; [[ $(units_pct 44160) == 23 ]] || fail "44160 of 192000 should be 23%"
  levels=100; write_seconds=0.1
  # Settings re-sent unchanged leave the loop alone: the service may push the
  # same values many times, and each must not restart the ramp or re-read.
  commands_seen=0
  paused=0; offset=5; brightness=40; last_applied=40; ramp_target=42; ramp_span=2
  handle_command auto on; handle_command offset 5
  [[ $brightness == 40 && $last_applied == 40 && $ramp_target == 42 ]] || fail "unchanged settings reset the loop: b=$brightness last=$last_applied ramp=$ramp_target"
  handle_command auto off
  [[ -z $brightness && $last_applied == 0 && $paused == 1 ]] || fail "auto off did not restart from the display"
  handle_command offset 7
  [[ $offset == 7 && -z $ramp_target ]] || fail "a new offset did not restart the ramp"
  (( commands_seen == 4 )) || fail "handled 4 commands, counted $commands_seen"
  paused=0; offset=0; brightness=""; last_applied=0; ramp_target=""; ramp_span=0
  # The sensor's kernel offset and scale apply before the curve.
  als_offset=10; als_scale=0.5; offset=0; run 30 "" "" 0 0 0 ""
  [[ $filtered == 20.0000000000 ]] || fail "(30 + 10) * 0.5 should be 20 lux, got $filtered"
  als_offset=0; als_scale=1
  # Display choice: Apple wins, else the panel; a disabled (lid shut) panel
  # is no choice at all.
  is_apple() { [[ $1 == DP-2 ]]; }
  [[ $(pick_monitor <<<'[{"name":"eDP-1"},{"name":"DP-2"}]') == "DP-2 apple" ]] || fail "Apple display not preferred"
  [[ $(pick_monitor <<<'[{"name":"eDP-1"},{"name":"DP-3"}]') == "eDP-1 panel" ]] || fail "panel not chosen without Apple"
  [[ $(pick_monitor <<<'[{"name":"DP-2"},{"name":"eDP-1","disabled":true}]') == "DP-2 apple" ]] || fail "closed lid with Apple"
  pick_monitor <<<'[{"name":"eDP-1","disabled":true},{"name":"DP-3"}]' >/dev/null && fail "closed lid without Apple should pick nothing"
  # Sensors: the Apple one only under 05ac; the panel takes the other one,
  # with the kernel's scale and offset, or a processed reading.
  iio_root=$(mktemp -d); trap 'rm -rf "$iio_root"' EXIT
  mkdir -p "$iio_root/usb-05ac:1114/dev0" "$iio_root/i2c-FRMW0005/dev1"
  ln -s "$iio_root/usb-05ac:1114/dev0" "$iio_root/iio:device0"
  ln -s "$iio_root/i2c-FRMW0005/dev1" "$iio_root/iio:device1"
  echo als >"$iio_root/usb-05ac:1114/dev0/name"; echo 1 >"$iio_root/usb-05ac:1114/dev0/in_illuminance_raw"
  echo als >"$iio_root/i2c-FRMW0005/dev1/name"; echo 1 >"$iio_root/i2c-FRMW0005/dev1/in_illuminance_raw"
  echo 0.25 >"$iio_root/i2c-FRMW0005/dev1/in_illuminance_scale"; echo 2 >"$iio_root/i2c-FRMW0005/dev1/in_illuminance_offset"
  [[ $(discover_sensor apple) == "$iio_root/iio:device0/in_illuminance_raw 0.001 0" ]] || fail "Apple sensor: $(discover_sensor apple)"
  [[ $(discover_sensor panel) == "$iio_root/iio:device1/in_illuminance_raw 0.25 2" ]] || fail "panel sensor: $(discover_sensor panel)"
  rm "$iio_root/i2c-FRMW0005/dev1/in_illuminance_raw"; echo 12.5 >"$iio_root/i2c-FRMW0005/dev1/in_illuminance_input"
  [[ $(discover_sensor panel) == "$iio_root/iio:device1/in_illuminance_input 1 0" ]] || fail "processed sensor: $(discover_sensor panel)"
  rm -r "$iio_root/i2c-FRMW0005" "$iio_root/iio:device1"
  discover_sensor panel >/dev/null && fail "the Apple sensor must not stand in for the panel's"
  # A display that cannot be read is dropped, so the next poll detects and
  # attaches it afresh: a backlight that came back under a new name is found.
  detect_monitor() { echo "eDP-1 panel"; }
  panel_attach() { backlight=gone; }
  panel_levels() { echo 100; }
  panel_read() { return 1; }
  sensor_file=$(mktemp); echo 5 >"$sensor_file"
  discover_sensor() { echo "$sensor_file 1 0"; }
  reset_state; poll >/dev/null
  [[ -z $monitor && -z $kind && -z $backlight ]] || fail "unreadable display kept: monitor=$monitor kind=$kind backlight=$backlight"
  rm -f "$sensor_file"
  echo ok
  exit 0
fi

trap 'exit 0' TERM INT
exec 3<&0  # the service's commands, readable inside write_ramp's frame loop

user_request=0
commands_seen=0
reset_state

while true; do
  poll
  # The wait doubles as the command reader; EOF means the service is gone.
  if read -t "$next_delay" -r command argument; then
    handle_command "$command" "${argument:-}"
    while read -t 0.01 -r command argument; do handle_command "$command" "${argument:-}"; done
  elif (( $? <= 128 )); then
    exit 0
  fi
done
