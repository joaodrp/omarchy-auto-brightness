#!/bin/bash

# Ambient-light brightness controller for one Apple Studio Display.
# Prints one JSON status line per poll on stdout; Service.qml reads them.
# Accepts "manual <percent>" and "forget" lines on stdin from the panel.
#
# Usage: controller [--offset N] [--paused] [--self-test]
#   --offset N   start with this correction, in brightness points
#   --paused     track the sensor and report, but never write brightness
#   --self-test  check the maths and exit
#
# Procedure, per 0.5 s poll (the shape Android documents and macOS shows):
#   lux -> smoothing -> asymmetric hysteresis + debounce -> curve -> ramp
# A manual change does not stop auto. It becomes the offset: the distance
# from the curve at that moment, kept at every light level until the user
# clears it. The service persists it, and passes it back on start.

set -u

als_scale=0.001  # the HID ALS reports millilux: ~10000 raw in a dim evening room
poll_interval=0.5
# ponytail: each read-back is a `sudo asdcontrol` call that lands in the
# journal; shorten it if hotkey changes feel slow to register.
manual_check_interval=10
write_check_interval=2   # and never overwrite a hotkey change older than this
lux_ema_alpha=0.25
brighten_threshold=0.10  # accept a brighter room at 10% above the accepted lux
darken_threshold=0.20    # and a darker one at 20% below
brighten_debounce=4      # seconds the new level must hold before it is accepted
darken_debounce=8
# Ramp: a fixed rate in points per second, but any change completes within
# the cap, the shape Android uses for automatic changes. This display shows
# about 20 visible steps, so a faster fade reads smoother, not harsher.
brighten_rate=20
brighten_cap=2
dim_rate=13
dim_cap=3

# Lux anchors -> brightness percent, interpolated in log2(lux). One percent is
# about 6 nits on this display (raw 400..60000 spans roughly 4..600 nits), so
# this sits between the sRGB reference (80 nits at 64 lux) and the display's
# own idea of "dim": 5% ~ 30 nits in the dark, 24% ~ 145 nits at 100 lux.
lux_points="0 5 20 50 100 200 400 800 1500 3000 5000"
pct_points="5 9 14 19 24 30 38 48 60 80 100"

offset=0
paused=0
self_test=0

while (( $# > 0 )); do
  case "$1" in
    --offset) offset="${2:-0}"; shift 2 ;;
    --paused) paused=1; shift ;;
    --self-test) self_test=1; shift ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done
[[ $offset =~ ^-?[0-9]+$ ]] || exit 2

# One awk pass over the whole pipeline. Inputs and outputs are the loop state,
# so bash never does floating point.
#   in:  lux filtered accepted pending_dir pending_since now brightness
#   out: filtered accepted pending_dir pending_since brightness curve target desired
calculate() {
  awk \
    -v lux="$1" -v filtered="$2" -v accepted="$3" \
    -v pending_dir="$4" -v pending_since="$5" -v now="$6" \
    -v brightness="$7" \
    -v offset="$offset" \
    -v lux_alpha="$lux_ema_alpha" \
    -v up_threshold="$brighten_threshold" -v down_threshold="$darken_threshold" \
    -v up_debounce="$brighten_debounce" -v down_debounce="$darken_debounce" \
    -v up_rate="$brighten_rate" -v up_cap="$brighten_cap" \
    -v down_rate="$dim_rate" -v down_cap="$dim_cap" -v poll="$poll_interval" \
    -v lux_points="$lux_points" -v pct_points="$pct_points" '
    function curve(value,    n, i, x, xa, xb, t) {
      n = split(lux_points, lp, " ")
      split(pct_points, pp, " ")
      if (value <= lp[1]) return pp[1]
      if (value >= lp[n]) return pp[n]
      x = log(value + 1) / log(2)
      for (i = 2; i <= n; i++) {
        if (value <= lp[i]) {
          xa = log(lp[i - 1] + 1) / log(2)
          xb = log(lp[i] + 1) / log(2)
          t = (x - xa) / (xb - xa)
          return pp[i - 1] + t * (pp[i] - pp[i - 1])
        }
      }
      return pp[n]
    }
    function clamp(v) { return v < 1 ? 1 : (v > 100 ? 100 : v) }
    BEGIN {
      filtered = filtered == "" ? lux : filtered + lux_alpha * (lux - filtered)

      if (accepted == "") {
        accepted = filtered
        pending_dir = 0
        pending_since = now
      } else {
        base = accepted > 1 ? accepted : 1
        dir = 0
        if (filtered > accepted + base * up_threshold) dir = 1
        else if (filtered < accepted - base * down_threshold) dir = -1
        if (dir != pending_dir) { pending_dir = dir; pending_since = now }
        if (dir != 0 && now - pending_since >= (dir > 0 ? up_debounce : down_debounce)) {
          accepted = filtered
          pending_dir = 0
          pending_since = now
        }
      }

      base_target = curve(accepted)
      target = clamp(base_target + offset)

      if (brightness == "") brightness = target
      else {
        delta = target - brightness
        span = delta < 0 ? -delta : delta
        rate = delta > 0 ? up_rate : down_rate
        cap = delta > 0 ? up_cap : down_cap
        step = rate * poll
        if (span / cap * poll > step) step = span / cap * poll
        brightness = span <= step ? target : brightness + (delta > 0 ? step : -step)
      }
      desired = int(clamp(brightness) + 0.5)

      printf "%.10f %.10f %d %d %.10f %.10f %.10f %d\n", \
        filtered, accepted, pending_dir, pending_since, brightness, base_target, target, desired
    }'
}

# A brightness the user chose becomes the offset from the curve as it stands
# now, and the ramp restarts from that value.
learn_manual() {
  local value="$1"
  [[ $value =~ ^[0-9]+$ ]] || return
  offset=$(awk -v v="$value" -v b="${base_target:-$value}" 'BEGIN { printf "%d", v - b + (v - b < 0 ? -0.5 : 0.5) }')
  brightness=$value
  last_applied=$value
  last_manual_check=$SECONDS
}

if (( self_test )); then
  fail() { echo "self-test: $*" >&2; exit 1; }
  # Curve anchors and the offset knob.
  read -r _ _ _ _ _ base target desired <<<"$(calculate 20 "" "" 0 0 0 "" 0)"
  [[ $desired == 14 ]] || fail "curve(20) gave $desired, want 14"
  offset=-10
  read -r _ _ _ _ _ _ _ desired <<<"$(calculate 0 "" "" 0 0 0 "" 0)"
  [[ $desired == 1 ]] || fail "curve(0)-10 should clamp to 1, got $desired"
  offset=10
  read -r _ _ _ _ _ _ _ desired <<<"$(calculate 5000 "" "" 0 0 0 "" 0)"
  [[ $desired == 100 ]] || fail "curve(5000)+10 should clamp to 100, got $desired"
  offset=0
  # The offset adds on top of the curve and is reported separately from it.
  offset=6
  read -r _ _ _ _ _ base target _ <<<"$(calculate 20 "" "" 0 0 0 "")"
  [[ $base == 14.0000000000 && $target == 20.0000000000 ]] || fail "offset not applied: $base $target"
  offset=0
  # A jump to 100 lux from an accepted 10 is not taken before the debounce.
  read -r filtered accepted dir since _ _ _ _ <<<"$(calculate 100 10 10 0 0 0 20 0)"
  [[ $accepted == 10.0000000000 && $dir == 1 ]] || fail "brighten accepted too early: $accepted dir=$dir"
  read -r _ accepted dir _ _ _ _ _ <<<"$(calculate 100 90 10 1 0 3 20 0)"
  [[ $accepted == 10.0000000000 ]] || fail "brighten accepted at 3 s, want 4: $accepted"
  read -r _ accepted dir _ _ _ _ _ <<<"$(calculate 100 90 10 1 0 4 20 0)"
  [[ $accepted != 10.0000000000 && $dir == 0 ]] || fail "brighten not accepted at 4 s: $accepted"
  # Darkening waits longer.
  read -r _ accepted _ _ _ _ _ _ <<<"$(calculate 1 1 100 -1 0 7 40 0)"
  [[ $accepted == 100.0000000000 ]] || fail "darken accepted at 7 s, want 8: $accepted"
  read -r _ accepted _ _ _ _ _ _ <<<"$(calculate 1 1 100 -1 0 8 40 0)"
  [[ $accepted == 1.0000000000 ]] || fail "darken not accepted at 8 s: $accepted"
  # Small wobble inside the band changes nothing.
  read -r _ accepted dir _ _ _ _ _ <<<"$(calculate 105 105 100 0 0 30 40 0)"
  [[ $accepted == 100.0000000000 && $dir == 0 ]] || fail "5% wobble was not ignored: $accepted dir=$dir"
  # The ramp: an 80-point brighten completes in the 2 s cap, so 20 per poll.
  read -r _ _ _ _ _ _ _ desired <<<"$(calculate 5000 5000 5000 0 0 0 20 0)"
  (( desired == 40 )) || fail "brighten step should be 20 points, got $((desired - 20))"
  # A 39-point dim takes the 3 s cap: 6.5 per poll.
  read -r _ _ _ _ _ _ _ desired <<<"$(calculate 0 0 0 0 0 0 40 0)"
  (( desired == 34 )) || fail "dim step should be 6.5 points, got $((40 - desired))"
  # A small change lands in one poll.
  read -r _ _ _ _ _ _ _ desired <<<"$(calculate 0 0 0 0 0 0 9 0)"
  (( desired == 5 )) || fail "small change should land at once, got $desired"
  # A manual 30% at a 14% curve point becomes a +16 offset.
  base_target=14; accepted_lux=20; learn_manual 30
  (( offset == 16 && brightness == 30 )) || fail "manual 30 over curve 14 gave offset $offset"
  echo ok
  exit 0
fi

detect_monitor() {
  timeout 5 hyprctl monitors -j 2>/dev/null | jq -er '
    first(.[] | select(
      (.disabled != true)
      and ((.make // "") | ascii_downcase | contains("apple"))
    ) | .name)'
}

# The display's ALS shows up as a HID sensor hub under the Apple USB device
# (vendor 05ac), which keeps a laptop's own light sensor out of the picture.
discover_sensor() {
  local path resolved
  for path in /sys/bus/iio/devices/iio:device*; do
    [[ -r $path/name && -r $path/in_illuminance_raw ]] || continue
    [[ $(<"$path/name") == als ]] || continue
    resolved=$(readlink -f "$path")
    [[ ${resolved,,} == *05ac:* ]] || continue
    printf '%s\n' "$path/in_illuminance_raw"
    return 0
  done
  return 1
}

read_brightness() {
  local value
  value=$(timeout 10 omarchy-brightness-display --monitor "$monitor" 2>/dev/null || true)
  [[ $value =~ ^[0-9]+$ ]] && printf '%s\n' "$value"
}

# Someone else moved the brightness since we last wrote it: learn it.
learn_external_change() {
  local current
  (( last_applied > 0 )) || return 1
  current=$(read_brightness) || return 1
  last_manual_check=$SECONDS
  (( current != last_applied )) || return 1
  learn_manual "$current"
}

emit_status() {
  local available="$1" error="$2"
  printf '{"available":%s,"monitor":"%s","lux":%.1f,"brightness":%d,"target":%.1f,"offset":%d,"paused":%s,"error":"%s"}\n' \
    "$available" "$monitor" "${filtered_lux:-0}" "${last_applied:-0}" "${target:-0}" \
    "$offset" "$([[ $paused == 1 ]] && echo true || echo false)" "$error"
}

reset_state() {
  monitor=""
  sensor=""
  filtered_lux=""
  accepted_lux=""
  pending_dir=0
  pending_since=0
  brightness=""
  base_target=""
  last_applied=0
  last_manual_check=0
}

trap 'exit 0' TERM INT

target=0
reset_state

while true; do
  while read -t 0.01 -r command argument; do
    case $command in
      manual) learn_manual "$argument" ;;
      forget) offset=0 ;;
    esac
  done

  if [[ -z $monitor ]] && ! monitor=$(detect_monitor); then
    emit_status false "No Apple display connected"
    sleep "$poll_interval"
    continue
  fi

  if [[ -z $sensor ]] && ! sensor=$(discover_sensor); then
    emit_status false "No Apple display light sensor found"
    sleep "$poll_interval"
    continue
  fi

  if ! raw=$(<"$sensor") || [[ ! $raw =~ ^[0-9]+$ ]]; then
    emit_status false "Could not read the ambient light sensor"
    sensor=""
    sleep "$poll_interval"
    continue
  fi

  lux=$(awk -v raw="$raw" -v scale="$als_scale" 'BEGIN { printf "%.10f", raw * scale }')

  # First active pass: start the ramp from where the display actually is.
  if (( ! paused )) && [[ -z $brightness ]]; then
    if current=$(read_brightness); then
      brightness=$current
      last_applied=$current
    fi
  fi

  read -r filtered_lux accepted_lux pending_dir pending_since brightness base_target target desired <<<"$(
    calculate "$lux" "$filtered_lux" "$accepted_lux" "$pending_dir" "$pending_since" "$SECONDS" "$brightness"
  )"

  if (( paused )); then
    emit_status true ""
    sleep "$poll_interval"
    continue
  fi

  since_check=$(( SECONDS - last_manual_check ))
  if (( since_check >= manual_check_interval )) \
      || (( desired != last_applied && since_check >= write_check_interval )); then
    if learn_external_change; then
      emit_status true ""
      sleep "$poll_interval"
      continue
    fi
  fi

  if (( desired != last_applied )); then
    if ! timeout 10 omarchy-brightness-display --no-osd --monitor "$monitor" "$desired%" >/dev/null 2>&1; then
      emit_status true "Brightness command failed"
      reset_state
      sleep "$poll_interval"
      continue
    fi
    last_applied=$desired
  fi

  emit_status true ""
  sleep "$poll_interval"
done
