{
  "schemaVersion": 1,
  "id": "io.github.joaodrp.auto-brightness",
  "name": "Brightness",
  "version": "0.1.0",
  "author": "João Pereira",
  "license": "MIT",
  "description": "Ambient-light auto brightness for the Apple Studio Display, from the Omarchy bar.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Brightness",
    "description": "Brightness slider with an Auto mode driven by the Studio Display's light sensor. Shows only while the display is connected.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "auto": true,
      "offset": 0
    },
    "schema": [
      {
        "key": "auto",
        "type": "boolean",
        "label": "Adjust brightness automatically",
        "defaultValue": true
      },
      {
        "key": "offset",
        "type": "integer",
        "label": "Shift the auto curve (brightness points)",
        "min": -30,
        "max": 30,
        "step": 1,
        "defaultValue": 0
      }
    ]
  }
}
